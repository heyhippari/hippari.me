---
import type { CollectionEntry } from "astro:content";
import { getArticleUrl } from "@/utils/content";
import { formatDate } from "@/utils/text";

interface Props {
  note: CollectionEntry<"articles">;
}

const { note } = Astro.props;
const date = formatDate(note.data.published);
const href = getArticleUrl(note.id, note.filePath);
---
<article class="group flex min-h-72 border border-border bg-card/40 p-6 transition-all hover:bg-card hover:shadow-xs">
  <a
    href={href}
    class="flex flex-1 flex-col"
  >
    <span class="font-mono text-xs uppercase tracking-wide text-muted-foreground">
      Article
    </span>

    <h3 class="mt-6  text-xl leading-relaxed group-hover:underline">
      {note.data.title}
    </h3>

    {note.data.description && (
      <p class="mt-3 text-base italic leading-relaxed text-muted-foreground">
        {note.data.description}
      </p>
    )}

    <time
      datetime={note.data.published.toISOString()}
      class="mt-auto pt-8 font-mono text-xs uppercase tracking-wide text-muted-foreground"
    >
      {date}
    </time>
  </a>
</article>
