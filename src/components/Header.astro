---
import { getConfig } from "@/utils/config";
import { getAssetPath } from "@/utils/url";

const siteConfig = await getConfig();
---
<header class="flex sticky top-0 z-40 bg-mauve-800 border-b border-border">
  <div class="layout-page h-16 flex items-center justify-between gap-4">
    <a href="/" class="font-bold text-xl shrink-0 text-mauve-200">
      {siteConfig.title}
    </a>
    <div class="flex items-center gap-6">
      <nav class="flex gap-4 text-mauve-200 text-sm tracking-wide">
        {siteConfig.navigation?.map((item) => (
          <a href={item.url}>{item.title}</a>
        ))}
      </nav>
      <div class="hidden sm:flex">
        <pagefind-modal-trigger placeholder="Search"></pagefind-modal-trigger>
      </div>
      <div class="flex sm:hidden">
        <pagefind-modal-trigger compact hide-shortcut></pagefind-modal-trigger>
      </div>
    </div>
  </div>
  <pagefind-config bundle-path={getAssetPath("pagefind/")}></pagefind-config>
  <pagefind-modal></pagefind-modal>
</header>
