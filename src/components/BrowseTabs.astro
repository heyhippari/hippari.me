---
/**
 * CSS-only collection-type tabs (All / Posts / Articles). No JS: three radio
 * inputs drive `peer-checked` visibility on three fully server-rendered
 * panels, passed in via the `all` / `posts` / `articles` named slots.
 *
 * Extracted from archive.astro so the same mechanism can be reused by the
 * browse pages without duplicating it.
 */
interface Props {
  defaultTab?: "all" | "posts" | "articles";
  groupName?: string;
}

const { defaultTab = "all", groupName = "collection-filter" } = Astro.props;
---

<div class="mt-8">
  <input
    type="radio"
    name={groupName}
    id={`${groupName}-all`}
    class="peer/all sr-only"
    checked={defaultTab === "all"}
  />
  <input
    type="radio"
    name={groupName}
    id={`${groupName}-posts`}
    class="peer/posts sr-only"
    checked={defaultTab === "posts"}
  />
  <input
    type="radio"
    name={groupName}
    id={`${groupName}-articles`}
    class="peer/articles sr-only"
    checked={defaultTab === "articles"}
  />

  <nav class="flex gap-6 border-b border-border/50 pb-4 font-mono text-xs uppercase tracking-wide text-muted-foreground">
    <label
      for={`${groupName}-all`}
      class="cursor-pointer transition-colors hover:text-foreground peer-checked/all:text-foreground peer-checked/all:underline peer-checked/all:underline-offset-4"
    >
      All
    </label>
    <label
      for={`${groupName}-posts`}
      class="cursor-pointer transition-colors hover:text-foreground peer-checked/posts:text-foreground peer-checked/posts:underline peer-checked/posts:underline-offset-4"
    >
      Posts
    </label>
    <label
      for={`${groupName}-articles`}
      class="cursor-pointer transition-colors hover:text-foreground peer-checked/articles:text-foreground peer-checked/articles:underline peer-checked/articles:underline-offset-4"
    >
      Articles
    </label>
  </nav>

  <div class="hidden peer-checked/all:block">
    <slot name="all" />
  </div>

  <div class="hidden peer-checked/posts:block">
    <slot name="posts" />
  </div>

  <div class="hidden peer-checked/articles:block">
    <slot name="articles" />
  </div>
</div>
