---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import GalleryLightbox from "@/components/GalleryLightbox.astro";
import StructuredData from "@/components/StructuredData.astro";
import { getAllArticles, getArticleSlugPath, buildBacklinkMap } from "@/utils/content";
import { formatDate } from "@/utils/text";
import { getAssetPath, absoluteUrl, getOgImagePath } from "@/utils/url";
import { getConfig } from "@/utils/config";

export async function getStaticPaths() {
  const articles = await getAllArticles();

  return articles.map((article) => ({
    params: { slug: getArticleSlugPath(article.id, article.filePath) },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const siteConfig = await getConfig();
const date = formatDate(article.data.published);

const backlinkMap = await buildBacklinkMap();
const articleSlug = getArticleSlugPath(article.id, article.filePath);
const backlinks = [
  ...new Map(
    (backlinkMap.get(articleSlug) ?? [])
      .filter((link) => link.slug !== articleSlug)
      .map((link) => [link.slug, link] as const)
  ).values(),
];

const articlePath = `/articles/${articleSlug}`;
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.data.title,
  description: article.data.description ?? siteConfig.description,
  datePublished: article.data.published.toISOString(),
  dateModified: (article.data.updated ?? article.data.published).toISOString(),
  author: { "@type": "Person", name: siteConfig.author.name },
  image: absoluteUrl(getOgImagePath(articlePath), Astro.site),
  url: absoluteUrl(articlePath, Astro.site),
};
---

<BaseLayout title={article.data.title} description={article.data.description} type="article">
  <StructuredData schema={schema} slot="head" />
  <div class="layout-content">
    <article class="markdown-content mx-auto py-8">
      <a
        href={getAssetPath("articles")}
        class="not-prose font-mono text-xs uppercase tracking-wide text-clay hover:underline"
      >
        ← Articles
      </a>

      <h1 class="not-prose mt-8  text-4xl leading-tight">
        {article.data.title}
      </h1>

      <div class="not-prose mt-4 flex items-center gap-2">
        <time
          datetime={article.data.published.toISOString()}
          class="rounded-xs border border-border px-1 font-mono text-xs uppercase tabular-nums text-muted-foreground"
        >
          {date}
        </time>
        {article.data.category && (
          <>
            <span class="text-muted-foreground/50">·</span>
            <span class="font-mono text-xs uppercase text-muted-foreground">
              {article.data.category}
            </span>
          </>
        )}
      </div>

      <hr class="not-prose mt-6 border-border/50" />
      <aside data-pagefind-body>
        <meta data-pagefind-meta="title[content]" content={article.data.title} />
        <meta data-pagefind-sort="date[content]" content={article.data.published.toISOString()} />
        <meta data-pagefind-filter="collection[content]" content={article.collection} />
        <meta data-pagefind-filter="category[content]" content={article.data.category} />
        <Content />
      </aside>

      {backlinks.length > 0 && (
        <div class="not-prose mt-10 border-t border-border/50 pt-4">
          <h2 class="font-mono text-xs uppercase tracking-wide text-muted-foreground">
            Backlinks
          </h2>
          <ul class="mt-2 space-y-1">
            {backlinks.map((link) => (
              <li>
                <a
                  href={getAssetPath(`articles/${link.slug}`)}
                  class=" text-foreground hover:underline"
                >
                  {link.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </article>
  </div>
  <GalleryLightbox />
</BaseLayout>
