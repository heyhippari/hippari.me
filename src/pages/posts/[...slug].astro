---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ImageWrapper from "@/components/ImageWrapper.astro";
import GalleryLightbox from "@/components/GalleryLightbox.astro";
import StructuredData from "@/components/StructuredData.astro";
import { getAllPosts, getPostSlugPath } from "@/utils/content";
import { getCoverImage } from "@/utils/image";
import { formatDate, calculateReadingTime } from "@/utils/text";
import { getAssetPath, absoluteUrl, getOgImagePath } from "@/utils/url";
import { getConfig } from "@/utils/config";

export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts.map((post) => ({
    params: { slug: getPostSlugPath(post.id, post.filePath) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteConfig = await getConfig();
const cover = getCoverImage(post.data.cover);
const date = formatDate(post.data.published);
const readingTime = calculateReadingTime(post.body ?? "");

const postPath = `/posts/${getPostSlugPath(post.id, post.filePath)}`;
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.published.toISOString(),
  dateModified: (post.data.updated ?? post.data.published).toISOString(),
  author: { "@type": "Person", name: siteConfig.author.name },
  image: absoluteUrl(getOgImagePath(postPath), Astro.site),
  url: absoluteUrl(postPath, Astro.site),
};
---

<BaseLayout title={post.data.title} description={post.data.description} type="article">
  <StructuredData schema={schema} slot="head" />
  <div class="layout-content">
    <header class="pt-8 mx-16">
      <a
        href={getAssetPath("posts")}
        class="font-mono text-xs uppercase tracking-wide text-purple-400 hover:underline"
      >
        ← Blog
      </a>

      {cover ? (
        <figure class="relative mt-6">
          <ImageWrapper
            src={cover}
            alt={post.data.title}
            bare
            class="aspect-2/1 w-full rounded object-cover grayscale"
          />
          <div class="absolute inset-0 bg-purple-400 mix-blend-multiply" aria-hidden="true"></div>
          <div class="absolute inset-0 bg-mauve-700 mix-blend-screen" aria-hidden="true"></div>
          <div class="absolute inset-0 bg-linear-to-t from-mauve-900/80 via-mauve-900/40 to-transparent" aria-hidden="true"></div>

          <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
            <h1 class="max-w-prose text-4xl leading-tight text-white">
              {post.data.title}
            </h1>

            <div class="mt-4 flex items-center gap-2">
              <time
                datetime={post.data.published.toISOString()}
                class="rounded-xs border border-white/40 px-1 font-mono text-xs uppercase tabular-nums text-white/90"
              >
                {date}
              </time>
              <span class="text-white/50">·</span>
              <span class="font-mono text-xs uppercase text-white/90">
                {readingTime.text}
              </span>
            </div>
          </div>
        </figure>
      ) : (
        <>
          <h1 class="mt-8  text-4xl leading-tight">
            {post.data.title}
          </h1>

          <div class="mt-4 flex items-center gap-2">
            <time
              datetime={post.data.published.toISOString()}
              class="rounded-xs border border-border px-1 font-mono text-xs uppercase tabular-nums text-muted-foreground"
            >
              {date}
            </time>
            <span class="text-muted-foreground/50">·</span>
            <span class="font-mono text-xs uppercase text-muted-foreground">
              {readingTime.text}
            </span>
          </div>

          <hr class="mt-6 border-border/50" />
        </>
      )}
    </header>

    <article class="annotated markdown-content mx-auto pb-8">
      <aside data-pagefind-body>
        <meta data-pagefind-meta="title[content]" content={post.data.title} />
        <meta data-pagefind-sort="date[content]" content={post.data.published.toISOString()} />
        <meta data-pagefind-filter="collection[content]" content={post.collection} />
        <meta data-pagefind-filter="category[content]" content={post.data.category} />
        <Content />
      </aside>
    </article>
  </div>
  <GalleryLightbox />
</BaseLayout>
