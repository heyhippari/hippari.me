---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import BrowseTabs from "@/components/BrowseTabs.astro";
import PostFeed from "@/components/PostFeed.astro";
import { getAllPosts, getAllArticles, getAllEntries } from "@/utils/content";

const allEntries = await getAllEntries();
const allPosts = await getAllPosts();
const allArticles = await getAllArticles();
---

<BaseLayout title="Archive">
  <div class="layout-content">
    <PageHeader
      eyebrow="Archive"
      title="All writing"
      lede="Posts and articles in reverse chronological order."
    />

    <BrowseTabs defaultTab="posts">
      <Fragment slot="all">
        <PostFeed posts={allEntries} variant="archive" />
      </Fragment>
      <Fragment slot="posts">
        <PostFeed posts={allPosts} variant="archive" />
      </Fragment>
      <Fragment slot="articles">
        <PostFeed posts={allArticles} variant="archive" />
      </Fragment>
    </BrowseTabs>
  </div>
</BaseLayout>
